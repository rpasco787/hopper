{
  "uid": "hopper-queue",
  "title": "hopper — queue",
  "tags": [
    "hopper"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Available by queue",
      "description": "Jobs ready to lease now, per queue. Every broker samples the same database, so brokers whose last sample is older than 15s are dropped and then max by is taken; summing would count each job once per broker.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (hopper_queue_depth{state=\"available\"} and on (job, instance) (time() - hopper_queue_depth_last_sample_timestamp_seconds < 15))",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Depth by state",
      "description": "Scheduled, available and leased jobs across all queues, taken from fresh brokers only and deduplicated per queue with max by before summing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (max by (queue, state) (hopper_queue_depth{state=~\"scheduled|available|leased\"} and on (job, instance) (time() - hopper_queue_depth_last_sample_timestamp_seconds < 15)))",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DLQ size",
      "description": "Dead jobs across all queues, from fresh brokers only, deduplicated per queue before summing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (queue) (hopper_queue_depth{state=\"dead\"} and on (job, instance) (time() - hopper_queue_depth_last_sample_timestamp_seconds < 15)))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Throughput (jobs/s)",
      "description": "Jobs enqueued, completed and failed per second, summed over brokers. Failed counts failed attempts, not jobs: a job that fails three times counts three.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hopper_jobs_enqueued_total[$__rate_interval]))",
          "legendFormat": "enqueued",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hopper_jobs_completed_total[$__rate_interval]))",
          "legendFormat": "completed",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hopper_jobs_failed_total[$__rate_interval]))",
          "legendFormat": "failed",
          "refId": "C"
        }
      ],
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lease expirations and dead-letters (/s)",
      "description": "Leases the reaper took back, and jobs moved to dead by Nack or expiry, per second and queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue) (rate(hopper_lease_expirations_total[$__rate_interval]))",
          "legendFormat": "expired {{queue}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue) (rate(hopper_jobs_dead_total[$__rate_interval]))",
          "legendFormat": "dead {{queue}}",
          "refId": "B"
        }
      ],
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Wait past due time, first lease (p50/p99 by queue)",
      "description": "How late jobs were leased for the first time, measured from due time (run_at), not from enqueue; a delayed job's intended delay is not counted, and retries are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, queue) (rate(hopper_job_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{queue}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, queue) (rate(hopper_job_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{queue}}",
          "refId": "B"
        }
      ],
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Run, lease → ack (p50/p99 by queue)",
      "description": "Broker-side time from lease to Ack for completed jobs, including the handler, SDK overhead and network.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, queue) (rate(hopper_job_run_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{queue}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, queue) (rate(hopper_job_run_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{queue}}",
          "refId": "B"
        }
      ],
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Handler p99 by queue and status",
      "description": "Worker-side handler wall time at p99, by queue and outcome (ok, error, panic).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, queue, status) (rate(hopper_worker_handler_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{queue}} {{status}}",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "In-flight handlers per worker",
      "description": "Handlers executing right now on each worker process.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (hopper_worker_inflight_jobs)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Unary RPC p99",
      "description": "Broker gRPC handling time at p99 per method, unary calls only: a LeaseJobs stream lives as long as its worker, so its handling time is stream lifetime, not latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, grpc_method) (rate(grpc_server_handling_seconds_bucket{grpc_type=\"unary\"}[$__rate_interval])))",
          "legendFormat": "{{grpc_method}}",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Worst depth sample age",
      "description": "Seconds since the least recently sampling broker last read queue depth. It shows the worst broker, so one stale replica is visible; red means that broker is excluded from the depth panels.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - min(hopper_queue_depth_last_sample_timestamp_seconds)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Depth samples by broker",
      "description": "Seconds since each broker last sampled queue depth successfully. A broker above 15s is excluded from the depth panels.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - hopper_queue_depth_last_sample_timestamp_seconds",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {}
    }
  ]
}
